# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …tranne l'esempio, che non ha chiavi dentro: sono solo i nomi delle
# variabili. Serve a chi installa il progetto per sapere cosa manca,
# invece di scoprirlo da un errore.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.caes-demo.json
.caes-demo.drafts.json
.caes-demo.clientes.json
.caes-demo.ajustes.json
.caes-demo.equipos.json
.caes-demo.firma.json

# Il log del server di sviluppo, quando lo si avvia staccato.
dev-server.log
