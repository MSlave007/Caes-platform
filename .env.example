# ══════════════════════════════════════════════════════════════════════
#  Variables de entorno
#
#  Copia este archivo a `.env.local` y rellena lo que necesites.
#  `.env.local` está en .gitignore y NUNCA se sube: ahí van las claves
#  de verdad, aquí solo los nombres.
#
#  ── LA REGLA DEL PREFIJO ──────────────────────────────────────────
#
#  Todo lo que empieza por NEXT_PUBLIC_ acaba dentro del paquete que
#  descarga el navegador. Es visible para cualquiera que abra las
#  herramientas de desarrollo.
#
#  Por eso solo llevan ese prefijo las dos cosas que SON públicas: la
#  dirección del proyecto Supabase y su clave anónima, que sin sesión
#  no abre nada porque las reglas de fila la frenan.
#
#  Todo lo demás —claves de modelos, clave de servicio, clave de
#  correo— se queda sin prefijo y vive solo en el servidor. Una clave
#  de pago en el navegador es la clave de cualquiera.
# ══════════════════════════════════════════════════════════════════════


# ── Supabase ─────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave de servicio. Se salta TODAS las reglas de fila: con ella se
# lee y se escribe cualquier cosa de cualquiera. Solo servidor, nunca
# en el navegador, nunca en un repositorio.
SUPABASE_SECRET_KEY=


# ── Lectura automática de documentos ─────────────────────────────────
# Cuál de los dos se usa lo decide CAES_LECTOR. Basta la clave del que
# se elija; sin ninguna, /api/extract contesta 503 y lo dice.

CAES_LECTOR=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: fija el modelo en vez del que viene por defecto.
# LECTOR_MODELO=


# ── Avisos por correo ────────────────────────────────────────────────
# Hoy: Resend (https://resend.com). Cambiar de proveedor toca una sola
# función, `enviar()` en src/lib/notify/email.ts.
#
# Sin estas dos, los avisos se escriben en el log del servidor y no sale
# nada: se ve que la llamada está en su sitio sin escribirle a nadie por
# error.
#
# EMAIL_DESDE tiene que estar en un dominio verificado en el proveedor.
# Con uno sin verificar el envío se rechaza, y el motivo sale en el log.

EMAIL_API_KEY=
# EMAIL_DESDE=CAES <avisos@tudominio.es>


# ── Modo demostración ────────────────────────────────────────────────
# Con `1`, /admin y /installer se abren SIN sesión. Sirve para enseñar
# el recorrido sin credenciales.
#
# En producción: fuera, o vacío. Con esto encendido la separación de
# roles no existe.
#
# Para probar la plataforma cerrada sin apagarlo para todos los que
# estén usando el mismo servidor, hay una cookie por petición:
# `caes_sin_demo=1`. Solo puede APAGAR la demo, nunca encenderla —
# encenderla desde el navegador sería una forma de quitar los controles
# desde la consola.

CAES_DEMO_MODE=1
